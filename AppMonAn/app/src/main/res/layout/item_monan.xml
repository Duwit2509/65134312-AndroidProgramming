<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_height="52dp"
    android:padding="1dp"
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:background="#FFC107"
    xmlns:android="http://schemas.android.com/apk/res/android"
     >
    <ImageView
        android:id="@+id/inAnhDaiDIen"
        android:background="#00BCD4"
        android:layout_width="50dp"
        android:layout_height="50dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingLeft="2dp">
        <TextView
            android:id="@+id/tvTenMonAn"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:textSize="13dp"
            android:text="Mon thu nhat"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/tvDonGia"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:text="2000000d"
            android:textSize="10dp"/>
        <TextView
            android:id="@+id/tvMoTa"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:text="Noi dung mo ta o day"
            android:textSize="10dp"/>
    </LinearLayout>
</LinearLayout>

