<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgSmallAvatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/reze"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="180dp"
        android:layout_height="320dp"
        android:layout_marginTop="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/reze"
        app:layout_constraintStart_toStartOf="@+id/imgSmallAvatar"
        app:layout_constraintTop_toBottomOf="@+id/imgSmallAvatar" />

    <TextView
        android:id="@+id/btnChuViDienTich"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_marginEnd="20dp"
        android:background="#67B5F4"
        android:gravity="center"
        android:onClick="ChuyenSangChuViDienTich"
        android:clickable="true"
        android:focusable="true"
        android:text="Tính Toán (CV/DT)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imgAvatar" />

    <TextView
        android:id="@+id/btnTinhThanh"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_marginTop="25dp"
        android:background="#67B5F4"
        android:gravity="center"
        android:onClick="ChuyenSangTinhThanh"
        android:clickable="true"
        android:focusable="true"
        android:text="Tỉnh Thành VN"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/btnChuViDienTich"
        app:layout_constraintTop_toBottomOf="@+id/btnChuViDienTich" />

    <TextView
        android:id="@+id/btnDuLich"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_marginTop="25dp"
        android:background="#67B5F4"
        android:gravity="center"
        android:onClick="ChuyenSangDuLich"
        android:clickable="true"
        android:focusable="true"
        android:text="Du Lịch Nha Trang"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/btnTinhThanh"
        app:layout_constraintTop_toBottomOf="@+id/btnTinhThanh" />

    <TextView
        android:id="@+id/btnGioiThieuSV"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_marginTop="25dp"
        android:background="#67B5F4"
        android:gravity="center"
        android:onClick="ChuyenSangGioiThieu"
        android:clickable="true"
        android:focusable="true"
        android:text="Giới thiệu SV"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/btnDuLich"
        app:layout_constraintTop_toBottomOf="@+id/btnDuLich" />

</androidx.constraintlayout.widget.ConstraintLayout>